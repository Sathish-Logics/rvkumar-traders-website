{
  "name": "rvkumar-traders-website",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "WATCHPACK_POLLING=true next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:studio": "prisma studio",
    "db:introspect": "prisma db pull",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db execute --file prisma/seed.sql",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:reset": "supabase db reset && prisma migrate deploy && prisma db execute --file prisma/seed.sql && prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/inter": "latest",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/manrope": "latest",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9",
    "lucide-react": "latest",
    "next": "latest",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "latest",
    "react-dom": "latest",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "^8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "supabase": "^2.122.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}

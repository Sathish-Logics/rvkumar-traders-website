# Public business details — replace placeholders before production launch.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_BUSINESS_EMAIL=

# Local development only. Production always ignores this bypass.
ADMIN_AUTH_BYPASS=false

# Supabase — publishable key is browser-safe; secret key must remain server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Prisma/PostgreSQL — use a pooled runtime URL and a direct migration URL in production.
DATABASE_URL=
DIRECT_URL=
RATE_LIMIT_SALT=

# Notifications — optional until verified business contacts and provider accounts exist.
OWNER_NOTIFICATION_EMAIL=
OWNER_NOTIFICATION_PHONE=
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CRON_SECRET=
